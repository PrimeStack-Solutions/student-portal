<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Study Materials</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav>
    <span>Welcome, <%= user.full_name %> (Student)</span>
    <div class="nav-links">
      <a href="/student/dashboard">Overview</a>
      <a href="/student/announcements">Announcements</a>
      <a href="/student/results">Results</a>
      <a href="/student/materials">Materials</a>
      <a href="/logout">Logout</a>
    </div>
  </nav>

  <div class="container">
    <h1>Material Dashboard</h1>

    <% if (canUploadMaterial) { %>
      <section class="card">
        <h2>Upload Materials</h2>
        <form action="/student/upload-material" method="POST" enctype="multipart/form-data">
          <label>Title</label>
          <input type="text" name="title" placeholder="Lecture notes" required>
          <label>Description</label>
          <textarea name="description" placeholder="Brief summary of the material"></textarea>
          <label>Category</label>
          <select name="category">
            <option value="General">General</option>
            <option value="Core Course">Core Course</option>
            <option value="Program Guide">Program Guide</option>
            <option value="Academic Support">Academic Support</option>
          </select>
          <label>PDF File</label>
          <input type="file" name="material" accept=".pdf" required>
          <button type="submit">Upload Material</button>
        </form>
      </section>
    <% } %>

    <section class="card">
      <h2>Available School Materials</h2>
      <% if (!materials.length) { %>
        <p>No materials have been uploaded yet.</p>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th>Title</th>
              <th>Category</th>
              <th>Uploaded By</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% materials.forEach(item => { %>
              <tr>
                <td><strong><%= item.title %></strong><br><small><%= item.description %></small></td>
                <td><%= item.category %></td>
                <td><%= item.uploaded_by_name || 'Unknown lecturer' %></td>
                <td><a href="/uploads/<%= item.file_name %>" target="_blank" rel="noopener noreferrer">Download</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </section>
  </div>
</body>
</html>
