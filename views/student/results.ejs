<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Academic Results</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav>
    <span>Welcome, <%= user.full_name %> (Student)</span>
    <div class="nav-links">
      <a href="/student/dashboard">Overview</a>
      <a href="/student/announcements">Announcements</a>
      <a href="/student/results">Results</a>
      <a href="/student/materials">Materials</a>
      <a href="/logout">Logout</a>
    </div>
  </nav>

  <div class="container">
    <h1>Results Dashboard</h1>
    <section class="card">
      <form method="GET" action="/student/results" style="display:flex; flex-direction:row; align-items:end; gap:12px; flex-wrap:wrap;">
        <div>
          <label for="semester">Filter by semester</label>
          <select id="semester" name="semester">
            <option value="all" <%= selectedSemester === 'all' ? 'selected' : '' %>>All semesters</option>
            <% semesters.forEach(semester => { %>
              <option value="<%= semester %>" <%= selectedSemester === semester ? 'selected' : '' %>><%= semester %></option>
            <% }); %>
          </select>
        </div>
        <button type="submit">Apply</button>
      </form>
    </section>

    <section class="card">
      <h2>Grading Scale</h2>
      <table>
        <thead>
          <tr><th>Grade</th><th>Percentage Range</th><th>Outcome</th></tr>
        </thead>
        <tbody>
          <tr><td>A+</td><td>90-100%</td><td>Distinction / Excellent</td></tr>
          <tr><td>A</td><td>80-89%</td><td>Very Good</td></tr>
          <tr><td>B+</td><td>70-79%</td><td>Good (High Merit)</td></tr>
          <tr><td>B</td><td>60-69%</td><td>Good</td></tr>
          <tr><td>C+</td><td>50-59%</td><td>Fair (Above Average)</td></tr>
          <tr><td>C</td><td>40-49%</td><td>Pass</td></tr>
          <tr><td>D+</td><td>30-39%</td><td>Fail, but eligible for supplementary exam</td></tr>
          <tr><td>D</td><td>0-29%</td><td>Fail, must repeat course</td></tr>
          <tr><td>E</td><td>-</td><td>Excluded from exams (not allowed to sit)</td></tr>
        </tbody>
      </table>
    </section>

    <% if (!results.length) { %>
      <section class="card">
        <p>No results have been published for you yet.</p>
      </section>
    <% } else { %>
      <% Object.keys(groupedResults).forEach(semester => { %>
        <section class="card">
          <h2><%= semester %></h2>
          <table>
            <thead>
              <tr>
                <th>Course</th>
                <th>Final Exam / 60</th>
                <th>Grade</th>
              </tr>
            </thead>
            <tbody>
              <% groupedResults[semester].forEach(result => { %>
                <tr>
                  <td><%= result.code %> - <%= result.name %></td>
                  <td><%= result.final_exam_score ?? 'Not recorded' %> / 60</td>
                  <td><%= result.grade %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </section>
      <% }); %>
    <% } %>
  </div>
</body>
</html>
