<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lecturer Dashboard</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav>
    <span>Welcome, <%= user.full_name %> (Lecturer)</span>
    <div class="nav-links">
      <a href="/lecturer/dashboard">Home</a>
      <a href="/lecturer/announcements">Announcements</a>
      <a href="/logout">Logout</a>
    </div>
  </nav>

  <div class="container">
    <div class="page-header">
      <h1>Lecturer Dashboard</h1>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <span class="label">Materials</span>
        <span class="value"><%= materials.length %></span>
      </div>
      <div class="stat-card">
        <span class="label">Students</span>
        <span class="value"><%= students.length %></span>
      </div>
    </div>

    <div class="dashboard-grid">
      <section class="card">
        <h2>Upload Assignment, Quiz or Material</h2>
        <form action="/lecturer/upload-material" method="POST" enctype="multipart/form-data">
          <input type="text" name="title" placeholder="Material title" required>
          <textarea name="description" placeholder="Short description"></textarea>
          <select name="category">
            <option value="Assignment">Assignment</option>
            <option value="Quiz">Quiz</option>
            <option value="General">General</option>
            <option value="Core Course">Core Course</option>
            <option value="Program Guide">Program Guide</option>
            <option value="Academic Support">Academic Support</option>
          </select>
          <input type="file" name="material" accept=".pdf,.doc,.docx" required>
          <button type="submit">Upload</button>
        </form>
      </section>
    </div>

    <section class="card">
      <h2>Upload Continuous Assessment</h2>
      <p class="hint">Enter Assignment 1, Assignment 2, Quiz 1, Quiz 2, and the Test out of 8 each. Their combined score is out of 40; below 15/40 disqualifies the student from the final exam for that course.</p>
      <form action="/lecturer/upload-ca" method="POST">
        <label>Student</label>
        <select name="student_id" required>
          <option value="">Select student</option>
          <% students.forEach(student => { %>
            <option value="<%= student.id %>"><%= student.full_name %> (<%= student.student_number %>)</option>
          <% }); %>
        </select>
        <label>Course</label>
        <select name="course_id" required>
          <option value="">Select course</option>
          <% courses.forEach(course => { %>
            <option value="<%= course.id %>"><%= course.code %> - <%= course.name %></option>
          <% }); %>
        </select>
        <label>Assessment</label>
        <select name="assessment_type" required>
          <option value="assignment">Assignment</option>
          <option value="quiz">Quiz</option>
          <option value="test">Test</option>
        </select>
        <label>Assessment Number</label>
        <select name="assessment_number" required>
          <option value="1">1</option>
          <option value="2">2</option>
        </select>
        <input type="number" name="score" min="0" max="8" step="0.1" placeholder="Score out of 8" required>
        <input type="text" name="semester" placeholder="Semester (for example Semester 1)" required>
        <button type="submit">Save CA Mark</button>
      </form>
      <h3>Special Case: Exclude Student</h3>
      <form action="/lecturer/mark-excluded" method="POST">
        <select name="student_id" required>
          <option value="">Select student</option>
          <% students.forEach(student => { %>
            <option value="<%= student.id %>"><%= student.full_name %> (<%= student.student_number %>)</option>
          <% }); %>
        </select>
        <select name="course_id" required>
          <option value="">Select course</option>
          <% courses.forEach(course => { %>
            <option value="<%= course.id %>"><%= course.code %> - <%= course.name %></option>
          <% }); %>
        </select>
        <input type="text" name="semester" placeholder="Semester (for example Semester 1)" required>
        <button type="submit">Record E</button>
      </form>
    </section>

    <section class="card">
      <h2>Excluded Students</h2>
      <% if (!excludedStudents.length) { %>
        <p>No students are currently excluded.</p>
      <% } else { %>
        <table>
          <thead><tr><th>Student</th><th>Course</th><th>Semester</th><th>Action</th></tr></thead>
          <tbody>
            <% excludedStudents.forEach(student => { %>
              <tr>
                <td><%= student.student_name %> (<%= student.student_number %>)</td>
                <td><%= student.code %> - <%= student.name %></td>
                <td><%= student.semester %></td>
                <td>
                  <form action="/lecturer/revoke-exclusion" method="POST">
                    <input type="hidden" name="result_id" value="<%= student.id %>">
                    <button type="submit">Revoke E</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </section>

    <section class="card">
      <h2>Continuous Assessment Records</h2>
      <table>
        <thead><tr><th>Student</th><th>Course</th><th>Semester</th><th>Assignment 1 / 8</th><th>Assignment 2 / 8</th><th>Quiz 1 / 8</th><th>Quiz 2 / 8</th><th>Test / 8</th><th>CA / 40</th><th>Final Exam Status</th></tr></thead>
        <tbody>
          <% assessments.forEach(item => { const caScore = Number(item.assignment_one || 0) + Number(item.assignment_two || 0) + Number(item.quiz_one || 0) + Number(item.quiz_two || 0) + Number(item.test_score || 0); %>
            <tr>
              <td><%= item.student_name %> (<%= item.student_number %>)</td>
              <td><%= item.code %> - <%= item.name %></td>
              <td><%= item.semester %></td>
              <td><%= item.assignment_one ?? 'Not recorded' %></td>
              <td><%= item.assignment_two ?? 'Not recorded' %></td>
              <td><%= item.quiz_one ?? 'Not recorded' %></td>
              <td><%= item.quiz_two ?? 'Not recorded' %></td>
              <td><%= item.test_score ?? 'Not recorded' %> / 8</td>
              <td><%= caScore %> / 40</td>
              <td><%= caScore >= 15 ? 'Eligible' : 'Disqualified' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </section>

    <section class="card">
      <h2>Uploaded Materials</h2>
      <table>
        <thead>
          <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Uploaded By</th>
            <th>Download</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% materials.forEach(item => { %>
            <tr>
              <td><%= item.title %></td>
              <td><%= item.category %></td>
              <td><%= item.uploaded_by_name || 'Lecturer' %></td>
              <td><a href="/uploads/<%= item.file_name %>" target="_blank">Open</a></td>
              <td>
                <form action="/lecturer/delete-material" method="POST" style="margin:0;" onsubmit="return confirm('Are you sure?');">
                  <input type="hidden" name="material_id" value="<%= item.id %>">
                  <button type="submit">Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </section>

  </div>
</body>
</html>
