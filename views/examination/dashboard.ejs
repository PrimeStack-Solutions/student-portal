<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Examination Department</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav>
    <span>Welcome, <%= user.full_name %> (Examination Department)</span>
    <div class="nav-links">
      <a href="/examination/dashboard">Home</a>
      <a href="/logout">Logout</a>
    </div>
  </nav>

  <div class="container">
    <div class="page-header">
      <h1>Examination Department</h1>
    </div>
    <section class="card">
      <h2>Upload Student Result</h2>
      <form action="/examination/upload-result" method="POST">
        <label for="student_id">Student</label>
        <select id="student_id" name="student_id" required>
          <option value="">Select student</option>
          <% students.forEach(student => { %>
            <option value="<%= student.id %>"><%= student.full_name %> (<%= student.student_number %>)</option>
          <% }); %>
        </select>
        <label for="course_id">Course</label>
        <select id="course_id" name="course_id" required>
          <option value="">Select course</option>
          <% courses.forEach(course => { %>
            <option value="<%= course.id %>"><%= course.code %> - <%= course.name %></option>
          <% }); %>
        </select>
        <input type="number" name="final_exam_score" min="0" max="60" step="0.1" placeholder="Final exam score out of 60">
        <input type="text" name="semester" placeholder="Semester (for example Fall)" required>
        <label><input type="checkbox" name="special_case_e"> Special case: record E (excluded from exams)</label>
        <button type="submit">Save Exam Result</button>
        <p class="hint">The system combines the CA mark out of 40 with the final exam mark out of 60 and calculates the percentage and grade automatically.</p>
      </form>
    </section>

    <section class="card">
      <h2>Excluded Students</h2>
      <% if (!excludedStudents.length) { %>
        <p>No students are currently excluded.</p>
      <% } else { %>
        <table>
          <thead><tr><th>Student</th><th>Course</th><th>Semester</th><th>Action</th></tr></thead>
          <tbody>
            <% excludedStudents.forEach(student => { %>
              <tr>
                <td><%= student.student_name %> (<%= student.student_number %>)</td>
                <td><%= student.code %> - <%= student.name %></td>
                <td><%= student.semester %></td>
                <td>
                  <form action="/examination/revoke-exclusion" method="POST">
                    <input type="hidden" name="result_id" value="<%= student.id %>">
                    <button type="submit">Revoke E</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </section>

    <section class="card">
      <h2>Published Results</h2>
      <table>
        <thead>
          <tr><th>Student</th><th>Course</th><th>Semester</th><th>Final Exam / 60</th><th>Grade</th></tr>
        </thead>
        <tbody>
          <% results.forEach(result => { %>
            <tr>
              <td><%= result.student_name %> (<%= result.student_number %>)</td>
              <td><%= result.code %> - <%= result.name %></td>
              <td><%= result.semester %></td>
              <td><%= result.final_exam_score ?? 'Not recorded' %> / 60</td>
              <td><%= result.grade %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </section>
  </div>
</body>
</html>
